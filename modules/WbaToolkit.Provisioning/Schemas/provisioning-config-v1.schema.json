{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wba.local/windows-toolkit/provisioning/v1.json",
  "title": "WbaToolkit.Provisioning — configuracao v1",
  "description": "Contrato canonico da configuracao de provisionamento inicial (SPEC-PROVISIONING-CONFIG, ADR-0033). Validacao operacional real e feita por Test-ToolkitProvisioningSchema; este documento e a referencia legivel do contrato, nao um validador executado pelo modulo na Fase 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deploymentId"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "deploymentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "computer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,14}$" },
        "timeZone": { "type": "string", "minLength": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match", "name", "dhcp"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "macAddress": { "type": "string" },
                  "pnpDeviceId": { "type": "string" },
                  "alias": { "type": "string" }
                }
              },
              "dhcp": { "type": "boolean" },
              "addresses": { "type": "array", "items": { "type": "string" } },
              "gateway": { "type": "string" },
              "dnsServers": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "match"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "match": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "serialNumber": { "type": "string" },
                  "uniqueId": { "type": "string" },
                  "busType": { "type": "string" },
                  "location": { "type": "string" },
                  "sizeBytes": { "type": "integer" },
                  "sizeToleranceBytes": { "type": "integer" }
                }
              },
              "fileSystem": { "type": "string", "enum": ["NTFS", "ReFS"] },
              "driveLetter": { "type": "string", "pattern": "^[D-Zd-z]$" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "thumbprint", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "thumbprint": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}$" },
          "store": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "filePath": { "type": "string" },
              "contentBase64": { "type": "string" },
              "pfxPasswordSecretRef": { "type": "string" }
            }
          }
        }
      }
    },
    "remoteAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "winrm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "certificateThumbprint": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}$" },
            "firewallProfile": { "type": "array", "items": { "enum": ["Domain", "Private", "Public"] } }
          }
        },
        "rdp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "firewallProfile": { "type": "array", "items": { "enum": ["Domain", "Private", "Public"] } }
          }
        }
      }
    },
    "firewall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "enabled": { "type": "boolean" },
              "direction": { "enum": ["Inbound", "Outbound"] },
              "protocol": { "enum": ["TCP", "UDP", "Any"] },
              "localPort": { "type": "string" },
              "profile": { "type": "array", "items": { "enum": ["Domain", "Private", "Public"] } }
            }
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ensure": { "type": "string", "enum": ["Present", "Absent"] },
          "password": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretRef": { "type": "string" }
            }
          },
          "groups": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productKeySecretRef", "partialProductKey"],
      "properties": {
        "productKeySecretRef": { "type": "string" },
        "partialProductKey": { "type": "string", "pattern": "^[A-Za-z0-9]{5}$" }
      }
    },
    "sysprep": {
      "type": "object",
      "description": "Integracao — preparacao ocorre antes da captura; provisionamento apos especializacao.",
      "additionalProperties": true
    },
    "extensions": {
      "type": "array",
      "description": "Futuro — extensibilidade controlada (SDK assinado + allowlist).",
      "items": { "type": "object", "additionalProperties": true }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onError": { "type": "string", "enum": ["Stop", "Continue"] },
        "maxAttemptsPerStep": { "type": "integer", "minimum": 1 },
        "reboot": { "type": "string", "enum": ["Never", "WhenRequired", "Manual"] },
        "cleanup": { "type": "string", "enum": ["RemoveSecretsAndConfig", "RemoveSecretsOnly", "RetainAll"] },
        "allowDestructiveStorage": { "type": "boolean" }
      }
    }
  }
}
